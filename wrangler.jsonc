{
  // 部署前需先创建真实资源并替换占位 ID：
  //   npx wrangler d1 create whl  ->  database_id
  //   npx wrangler kv namespace create KV -> id
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tour",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whl",
      "database_id": "ec3cc695-70bc-47ab-a454-5ca62ec22dd6"
    },
    // v1.0.0：认证中心库只读绑定（球队目录/绑定关系派生读）。写路径走 HMAC 机器通道
    // （worker/lib/authClient.ts），密钥用 secret：npx wrangler secret put AUTH_BIND_SECRET
    // （与 auth 服务的 BIND_SECRET 同值；不配则派生读为空、绑定端点报「认证中心未配置」）
    {
      "binding": "AUTH_DB",
      "database_name": "whl-auth",
      "database_id": "b76d1129-77ae-4844-931c-1c7b00a9b048"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "87e2d78308bc47e9b36dc6de53be0458"
    }
  ],
  // 队徽/封面图存储；本地 dev 自动模拟，部署前需在 CF dash 创建同名桶 whl-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "whl-media"
    }
  ],
  // 统一认证中心（生产）：AUTH_MODE="oidc" 显式开启 RP 模式（v3.0.0 显式化，登录跳 auth /authorize，
  // 会话存本地 oidc_session 表 + __Host-tour_session cookie）；撤掉 AUTH_MODE 重新部署即回兼容模式。
  // 注意与上一段的 COOKIE_DOMAIN 不同：这些值是有意写进配置的（部署可复现、可回滚），不是 secret。
  "vars": {
    "AUTH_MODE": "oidc",
    "OIDC_ISSUER": "https://auth.whleague.win",
    "OIDC_CLIENT_ID": "tour",
    // v4.0.0：俱乐部平台基址。名册同步（cron + POST /api/admin/sync-rosters）从这里拉 /api/squads；
    // 撤掉这一行 = 同步整体跳过（球员表随即退回「手工录入」的旧行为，可作回滚开关）
    "CLUB_API_BASE": "https://club.whleague.win"
  },
  // v4.0.0：每小时拉一次俱乐部平台一线队名册。写库只在真有差异时发生，稳态下这个 cron 是纯读；
  // 立即同步不等下一小时，用 POST /api/admin/sync-rosters（先加 ?dryRun=1 核对预期）。
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  // 同主域子系统共享登录态（竞猜系统 guess.whleague.win）：设为主域根
  // 注意：vars 会被 wrangler deploy 覆盖，用 secret 更稳：npx wrangler secret put COOKIE_DOMAIN  ->  ".whleague.win"
  // "vars": { "COOKIE_DOMAIN": ".whleague.win" },
  // Smart Placement：让 CF 把 Worker 计算挪到靠近 D1 库（亚太）的数据中心，削减跨洋查询往返；部署后 ~15 分钟热身
  "placement": {
    "mode": "smart"
  }
}
