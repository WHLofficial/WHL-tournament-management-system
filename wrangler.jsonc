{
  // 部署前需先创建真实资源并替换占位 ID：
  //   npx wrangler d1 create whl  ->  database_id
  //   npx wrangler kv namespace create KV -> id
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tour",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whl",
      "database_id": "ec3cc695-70bc-47ab-a454-5ca62ec22dd6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "87e2d78308bc47e9b36dc6de53be0458"
    }
  ],
  // 队徽/封面图存储；本地 dev 自动模拟，部署前需在 CF dash 创建同名桶 whl-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "whl-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
