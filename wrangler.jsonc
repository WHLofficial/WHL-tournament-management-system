{
  // 部署前需先创建真实资源并替换占位 ID：
  //   npx wrangler d1 create whl  ->  database_id
  //   npx wrangler kv namespace create KV -> id
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tour",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whl",
      "database_id": "ec3cc695-70bc-47ab-a454-5ca62ec22dd6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "87e2d78308bc47e9b36dc6de53be0458"
    }
  ],
  // 队徽/封面图存储；本地 dev 自动模拟，部署前需在 CF dash 创建同名桶 whl-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "whl-media"
    }
  ],
  // 统一认证中心（生产）：配了这两项即从「共享会话」切到 OIDC 模式（登录跳 auth /authorize，
  // 会话存本地 oidc_session 表 + __Host-tour_session cookie）；撤掉这两个变量重新部署即回兼容模式。
  // 注意与上一段的 COOKIE_DOMAIN 不同：那两个值是有意写进配置的（部署可复现、可回滚），不是 secret。
  "vars": {
    "OIDC_ISSUER": "https://auth.whleague.win",
    "OIDC_CLIENT_ID": "tour"
  },
  "observability": {
    "enabled": true
  },
  // 同主域子系统共享登录态（竞猜系统 guess.whleague.win）：设为主域根
  // 注意：vars 会被 wrangler deploy 覆盖，用 secret 更稳：npx wrangler secret put COOKIE_DOMAIN  ->  ".whleague.win"
  // "vars": { "COOKIE_DOMAIN": ".whleague.win" },
  // Smart Placement：让 CF 把 Worker 计算挪到靠近 D1 库（亚太）的数据中心，削减跨洋查询往返；部署后 ~15 分钟热身
  "placement": {
    "mode": "smart"
  }
}
